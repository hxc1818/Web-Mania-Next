{
  "name": "web-mania-next",
  "version": "1.0.0",
  "description": "基于 Electron 和 HTML5 Canvas 构建的高性能跨平台下落式音乐游戏",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron . --ignore-gpu-blocklist --disable-gpu-sandbox --enable-features=UseSkiaGraphite",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "osu",
    "mania",
    "rhythm-game",
    "electron",
    "canvas",
    "multiplayer",
    "web-mania"
  ],
  "author": "hxc1818 <hxc1818@outlook.com>",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxc1818/Web-Mania-Next.git"
  },
  "bugs": {
    "url": "https://github.com/hxc1818/Web-Mania-Next/issues"
  },
  "homepage": "https://github.com/hxc1818/Web-Mania-Next#readme",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.hxc1818.webmanianext",
    "productName": "Web Mania Next",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Web Mania Next"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "identity": null
    }
  }
}
